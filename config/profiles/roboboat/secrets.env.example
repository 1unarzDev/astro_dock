# RoboBoat keys for the ignored .env (keys only; the YAMLs here name them under credentials:/jump:).
# Radios (radio.yaml): airOS ssh login, and an optional ssh jump host on the boat LAN for off-LAN runs.
UBNT_USER=
UBNT_PASSWORD=
UBNT_JUMP=
# Boat computer login for `hw.sh radio measure` (key auth unless a password is set).
BOAT_HOST_USER=
BOAT_HOST_PASSWORD=
# Optional ssh host on the boat LAN that `hw.sh lidar` runs its curl requests on.
LIDAR_JUMP=
# DD-WRT router (router.yaml): ssh login (root) and password, web-admin password, Wi-Fi WPA2 key (8-63).
ROUTER_USER=
ROUTER_PASSWORD=
ROUTER_ADMIN_PASSWORD=
BOAT_WIFI_PASSWORD=
