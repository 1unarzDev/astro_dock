# Boat LAN layout, shared by router_setup.sh and setup.linux.sh (gateway, clock).
# The router serves DHCP and Wi-Fi; the gateway device (any Linux host running the
# gateway stage) forwards the LAN's internet through its own routing, WARP included.
BOAT_SUBNET=192.168.0.0/24
NETMASK=255.255.255.0
ROUTER_IP=192.168.0.1
GATEWAY_IP=192.168.0.2
DHCP_START=100
DHCP_COUNT=50
# Reservations sit above the pool (.100-.149): MAC=hostname=address.
STATIC_LEASES="56:e2:03:5c:60:22=blastoise-odroid=192.168.0.152 3c:6d:66:bf:6b:e2=blastoise-jetson=192.168.0.153"
BOAT_TRANSPORT_IP=192.168.0.152
# Boat computer serving time (chrony); `setup.linux.sh --components clock` uses it for ASTRO_NTP_SERVER=boat.
BOAT_TIME_SERVER=192.168.0.152
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=8.8.8.8
# Ubiquiti airMAX link (ubiquiti_setup.sh): both radios bridge onto this LAN.
# Secrets (radio login, WPA key) stay on the radios and in snapshots under
# ~/.local/state/astro_dock/ubiquiti; ssh prompts for the login.
UBNT_SSID=blastoise
UBNT_ROCKET_IP=192.168.0.22
UBNT_ROCKET_MAC=ac:8b:a9:c8:aa:f9
UBNT_ROCKET_ROLE=ap
UBNT_BULLET_IP=192.168.0.21
UBNT_BULLET_MAC=ac:8b:a9:c8:ca:18
UBNT_BULLET_ROLE=station
# airOS system.cfg key=value pairs that `apply` sets; only keys already on the radio.
UBNT_ROCKET_CFG=""
UBNT_BULLET_CFG=""
