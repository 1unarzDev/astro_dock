// Boat router: squirtle's bridge connects here. Only the listed topics cross.
{
  mode: "router",
  listen: { endpoints: ["tcp/0.0.0.0:7447"] },
  scouting: { multicast: { enabled: false } },
  plugins: {
    ros2dds: {
      domain: 42,
      allow: {
        publishers: ["^/transport/blastoise/(detections|odom)$"],
        subscribers: ["^/transport/squirtle/(detections|odom)$"],
      },
    },
  },
}
