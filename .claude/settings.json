{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "timeout": 5, "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.agents/hook.py\" claude"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "timeout": 5, "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.agents/hook.py\" claude"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "timeout": 5, "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.agents/hook.py\" claude"}
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "timeout": 5, "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.agents/hook.py\" claude"}
        ]
      }
    ]
  }
}
