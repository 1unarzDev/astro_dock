{
  "name": "Roboboat Jazzy Development Container",
  "dockerComposeFile": [
    "docker-compose.yml",
    "docker-compose.override.yml"
  ],
  "service": "dev",
  "runServices": ["dev"],
  "workspaceFolder": "/home/roboboat/roboboat_ws",
  "postCreateCommand": ".devcontainer/postcreate.sh",
  "containerUser": "roboboat",
  "remoteUser": "roboboat",
  "updateRemoteUserUID": false,
  "overrideCommand": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-themes",
        "twxs.cmake",
        "donjayamanne.python-extension-pack",
        "eamodio.gitlens",
        "Ranch-Hand-Robotics.rde-pack"
      ]
    }
  },
  "forwardPorts": [10000]
}
