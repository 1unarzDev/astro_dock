[Unit]
Description=Astro ROS 2 LARGE_DATA PointCloud2 ingest
After=docker.service
Wants=docker.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/astro-pointcloud-bridge.env
ExecStartPre=/bin/bash -lc '/usr/bin/docker inspect "$ASTRO_POINTCLOUD_CONTAINER"'
ExecStart=/bin/bash -lc 'exec /usr/bin/docker exec -e ROS_DISTRO="$ASTRO_ROS_DISTRO" -e ROS_DOMAIN_ID="$ASTRO_ROS_DOMAIN_ID" -e ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET -e ROS_WS=/home/roboboat/roboboat_ws -e FASTDDS_BUILTIN_TRANSPORTS=LARGE_DATA "$ASTRO_POINTCLOUD_CONTAINER" /home/roboboat/roboboat_ws/.devcontainer/run-mixed-pointcloud-bridge.sh ingest --topic "$ASTRO_POINTCLOUD_TOPIC" --bind 127.0.0.1 --port "$ASTRO_POINTCLOUD_PORT" --max-bytes "${ASTRO_POINTCLOUD_MAX_BYTES:-32768}"'
ExecStop=/bin/bash -lc '/usr/bin/docker exec "$ASTRO_POINTCLOUD_CONTAINER" pkill -TERM -f "[m]ixed_pointcloud_bridge.py ingest" || true'
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=default.target
