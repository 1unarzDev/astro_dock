+bool ZedCamera::ingestCustomObjects(rclcpp::Time t)
+{
+  // The grab thread already published this image. Hold its SDK depth until the
+  // external detector replies for exactly this acquisition, never a later grab.
+  std::unique_lock<std::mutex> lock(mCustomObjectsMutex);
+  if (!mCustomObjectsReady.wait_for(lock, std::chrono::milliseconds(500), [this, t]() {
+      return mCustomObjects && rclcpp::Time(mCustomObjects->header.stamp) == t;
+    }))
+  {
+    return false;
+  }
+  auto msg = mCustomObjects;
+  mCustomObjects.reset();
+  lock.unlock();
+  if (msg->header.frame_id != mRgbOptFrameId || msg->objects.size() > 256) {
+    return false;
+  }
+  std::vector<sl::CustomBoxObjectData> boxes;
+  mCustomLabels.clear();
+  for (const auto & object : msg->objects) {
+    if (!std::isfinite(object.confidence) || object.confidence < 0 || object.confidence > 100) {
+      continue;
+    }
+    sl::CustomBoxObjectData box;
+    box.label = object.label_id;
+    box.probability = object.confidence / 100.f;
+    box.is_grounded = false;  // Floating buoys do not share a detected floor plane.
+    box.bounding_box_2d.clear();  // SDK 4 preallocates four corners.
+    for (const auto & corner : object.bounding_box_2d.corners) {
+      const auto x = std::min(static_cast<unsigned int>(mCamWidth - 1),
+          static_cast<unsigned int>(corner.kp[0] * mCamWidth / mMatResol.width));
+      const auto y = std::min(static_cast<unsigned int>(mCamHeight - 1),
+          static_cast<unsigned int>(corner.kp[1] * mCamHeight / mMatResol.height));
+      box.bounding_box_2d.emplace_back(x, y);
+    }
+    if (box.bounding_box_2d[2].x <= box.bounding_box_2d[0].x ||
+      box.bounding_box_2d[2].y <= box.bounding_box_2d[0].y)
+    {
+      continue;
+    }
+    mCustomLabels[box.label] = object.label;
+    boxes.push_back(box);
+  }
+  const auto result = mZed.ingestCustomBoxObjects(boxes, mObjDetInstID);
+  if (result != sl::ERROR_CODE::SUCCESS) {
+    RCLCPP_WARN_STREAM(get_logger(), "Custom box ingestion: " << sl::toString(result));
+    return false;
+  }
+  return true;
+}
