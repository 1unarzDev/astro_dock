ARG BASE_IMAGE=stereolabs/zed:5.4.1-devel-l4t-r36.4@sha256:60bb5a325c1d98cb7be18f8ddd066ba1796122dc4cbfeccdd77784d4ee436583
FROM ${BASE_IMAGE}

ARG ROS_DISTRO=jazzy
# Upstream ROS 2 release snapshot; its ros2.repos pins every core repo to a release.
ARG ROS2_RELEASE=release-jazzy-20260618
ARG ROS_POLICY_REF=86171bccda22de6e83ccc69b3c0e67af99dece7c
ARG ZED_WRAPPER_REF=86171bccda22de6e83ccc69b3c0e67af99dece7c
ARG VELODYNE_REF=0f2a3bb1dde4fa91cbafad8a3f9f89b66c2a1350
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    ROS_DISTRO=${ROS_DISTRO} \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Bootstrap only what is required to fetch and execute the pinned dependency
# policy. ROS, wrapper, graphics, and Python dependency lists live upstream.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates git locales python3-pip python3-venv sudo udev \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# Build the expensive ROS foundation independently of the ZED wrapper. A ZED
# update can now reuse this complete layer as long as the compatibility policy
# and locked ROS source graph remain unchanged.
RUN git clone --filter=blob:none --no-checkout \
        https://github.com/stereolabs/zed-ros2-wrapper.git /tmp/ros-policy \
    && git -C /tmp/ros-policy checkout "${ROS_POLICY_REF}" \
    && install -m 0755 /tmp/ros-policy/docker/scripts/install_ros2.sh /tmp/install_ros2.sh \
    && sed -i \
        's#ros2/ros2/${ROS_DISTRO}/ros2.repos#ros2/ros2/'"${ROS2_RELEASE}"'/ros2.repos#' \
        /tmp/install_ros2.sh \
    && grep -Fq "ros2/ros2/${ROS2_RELEASE}/ros2.repos" /tmp/install_ros2.sh \
    && /tmp/install_ros2.sh "${ROS_DISTRO}" \
    && test -f "/opt/ros/${ROS_DISTRO}/setup.bash" \
    && rm -rf /tmp/ros-policy /tmp/install_ros2.sh \
        /opt/ros2_build/src /var/lib/apt/lists/*

# The wrapper and its curated source dependencies are a separate cache seam.
RUN mkdir -p /root/ros2_ws/src \
    && git clone --filter=blob:none --no-checkout \
        https://github.com/stereolabs/zed-ros2-wrapper.git /root/ros2_ws/src/zed-ros2-wrapper \
    && git -C /root/ros2_ws/src/zed-ros2-wrapper checkout "${ZED_WRAPPER_REF}" \
    && install -m 0644 \
        /root/ros2_ws/src/zed-ros2-wrapper/docker/scripts/zed-wrapper-deps.repos \
        /tmp/zed-wrapper-deps.repos \
    && install -m 0755 \
        /root/ros2_ws/src/zed-ros2-wrapper/docker/scripts/build_wrapper.sh \
        /tmp/build_wrapper.sh \
    && /tmp/build_wrapper.sh "${ROS_DISTRO}" \
    && test -f /root/ros2_ws/install/setup.bash \
    && rm -rf /tmp/build_wrapper.sh /tmp/zed-wrapper-deps.repos /var/lib/apt/lists/*

# Jazzy debs do not exist for JetPack's Jammy userspace. Build the Velodyne
# packages after the ZED dependency overlay, which supplies their ROS
# dependencies, while Jammy supplies the native PCL and pcap libraries.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpcap-dev libpcl-dev \
    && git clone --filter=blob:none --no-checkout \
        https://github.com/ros-drivers/velodyne.git /tmp/velodyne_ws/src/velodyne \
    && git -C /tmp/velodyne_ws/src/velodyne checkout "${VELODYNE_REF}" \
    && source /opt/ros/${ROS_DISTRO}/setup.bash \
    && source /root/ros2_ws/install/setup.bash \
    && cd /tmp/velodyne_ws \
    && colcon build --merge-install --install-base /opt/velodyne \
        --packages-up-to velodyne_driver velodyne_pointcloud \
    && rm -rf /tmp/velodyne_ws /var/lib/apt/lists/*

COPY normalize-python-permissions.sh /usr/local/sbin/normalize-python-permissions

RUN test -f "/opt/ros/${ROS_DISTRO}/setup.bash" \
    && test -f /root/ros2_ws/install/setup.bash \
    && ln -s /root/ros2_ws/install /opt/zed_ros2 \
    && chmod 0711 /root \
    && python3 -m pip install --no-cache-dir colcon-common-extensions 'setuptools<81' vcstool \
    && /usr/local/sbin/normalize-python-permissions \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN printf '%s\n' \
      "source /opt/ros/${ROS_DISTRO}/setup.bash" \
      'source /opt/zed_ros2/setup.bash' \
      'source /opt/velodyne/setup.bash' \
      'if [ -f /opt/astro-extra/setup.bash ]; then source /opt/astro-extra/setup.bash; fi' \
      > /opt/astro-setup.bash

CMD ["bash"]

# Stereolabs' L4T image installs the SDK with skip_tools; validation needs
# ZED_Diagnostic. Copy only that tool and its Qt runtime from the same pinned
# installer, without reinstalling the SDK. CUDA and Tegra libraries come from the
# Jetson host at run time, so the link check covers only Qt.
ARG ZED_SDK_URL=https://download.stereolabs.com/zedsdk/5.4.1/l4t36.4/jetsons
ARG ZED_SDK_SHA256=680ffc85e1999eb953703d76f570fe8492fa7c67719575f88c83caefd854dfcc
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl zstd libqt5network5 libqt5sql5 \
        libqt5svg5 libqt5widgets5 libqt5xml5 \
    && curl -fsSL -o /tmp/zed_sdk.run "${ZED_SDK_URL}" \
    && echo "${ZED_SDK_SHA256}  /tmp/zed_sdk.run" | sha256sum -c - \
    && size="$(sed -n 's/^filesizes="\([0-9]*\)"$/\1/p' /tmp/zed_sdk.run | head -1)" \
    && tail -c "${size}" /tmp/zed_sdk.run | zstd -dc \
        | tar -x --no-same-owner -C /usr/local/zed ./tools/ZED_Diagnostic \
    && test -x /usr/local/zed/tools/ZED_Diagnostic \
    && ! ldd /usr/local/zed/tools/ZED_Diagnostic | grep 'libQt.*not found' \
    && rm -rf /tmp/zed_sdk.run /var/lib/apt/lists/*

COPY astro-ros-install.sh /usr/local/bin/astro-ros-install
COPY jetson-packages.txt /tmp/jetson-packages.txt
# Jammy's OpenVDB 8.1 headers do not build with its oneTBB; point the voxel
# layer at the OpenVDB 10 that openvdb_vendor builds, ahead of /usr.
RUN chmod +x /usr/local/bin/astro-ros-install \
    && OpenVDB_ROOT=/opt/astro-extra/opt/openvdb_vendor \
        /usr/local/bin/astro-ros-install --file /tmp/jetson-packages.txt \
    && source /opt/astro-setup.bash \
    && stvl="$(ros2 pkg prefix spatio_temporal_voxel_layer)" \
    && ldd "$stvl"/lib/*.so | grep -q 'openvdb_vendor/lib/libopenvdb' \
    && ! ldd "$stvl"/lib/*.so | grep 'not found'
