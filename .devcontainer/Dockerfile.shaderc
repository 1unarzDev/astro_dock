FROM ubuntu:22.04

ARG SHADERC_REF=f8a25c591bf5edbb462ca4aea99dcc666f096d13
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake git python3 \
    && git clone https://github.com/google/shaderc.git /tmp/shaderc \
    && cd /tmp/shaderc \
    && git checkout "${SHADERC_REF}" \
    && ./utils/git-sync-deps \
    && cmake -S . -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/shaderc \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DSHADERC_SKIP_COPYRIGHT_CHECK=ON \
        -DSHADERC_SKIP_EXAMPLES=ON \
        -DSHADERC_SKIP_TESTS=ON \
    && cmake --build build --parallel "$(nproc)" \
    && cmake --install build \
    && test -x /opt/shaderc/bin/glslc \
    && rm -rf /tmp/shaderc /var/lib/apt/lists/*
