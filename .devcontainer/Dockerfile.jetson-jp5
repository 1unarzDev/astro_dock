# Legacy Xavier-family JetPack 5 host ONLY. Never use on JetPack 4 or 6.
ARG BASE_IMAGE=stereolabs/zed:4.0-devel-l4t-r35.4@sha256:9c70d89b87260726c679de3d830cde810ccfcb23d929c9dbed846204142f7db5
FROM ${BASE_IMAGE}
ARG ZED_WRAPPER_REF=77a043a6d7fb5802ac49562e61efc1a4d6b5fc3f
ENV DEBIAN_FRONTEND=noninteractive ROS_DISTRO=foxy \
    ROS_WS=/home/roboboat/roboboat_ws SHELL=/bin/bash \
    LANG=C.UTF-8 ROS_DOMAIN_ID=142
LABEL org.astro.jetpack="5" org.astro.ros="foxy" org.astro.role="legacy-camera"
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg2 git sudo python3-pip python3-venv \
    && curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
       | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg
RUN echo 'deb [arch=arm64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu focal main' \
      > /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends \
      ros-foxy-ros-base python3-colcon-common-extensions python3-rosdep \
      ros-foxy-xacro ros-foxy-robot-state-publisher \
    && if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi \
    && rosdep update --include-eol-distros --rosdistro foxy
RUN git clone https://github.com/stereolabs/zed-ros2-wrapper.git /tmp/zed_ws/src/zed-ros2-wrapper \
    && git -C /tmp/zed_ws/src/zed-ros2-wrapper checkout "${ZED_WRAPPER_REF}" \
    && git -C /tmp/zed_ws/src/zed-ros2-wrapper submodule update --init --recursive \
    && apt-get update \
    && rosdep install --from-paths /tmp/zed_ws/src --ignore-src --rosdistro foxy -y \
    && source /opt/ros/foxy/setup.bash && cd /tmp/zed_ws \
    && CMAKE_BUILD_PARALLEL_LEVEL=2 colcon build --merge-install \
      --install-base /opt/zed_ros2 --executor sequential \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
      -DCMAKE_EXE_LINKER_FLAGS=-Wl,--allow-shlib-undefined \
    && rm -rf /tmp/zed_ws /var/lib/apt/lists/*
COPY configure-zed-access.sh /usr/local/sbin/configure-zed-access
COPY astro-ros-install.sh /usr/local/bin/astro-ros-install
COPY jetson-user.sh /usr/local/sbin/jetson-user
COPY jetson-jp5-packages.txt /tmp/jetson-packages.txt
RUN chmod +x /usr/local/bin/astro-ros-install /usr/local/sbin/jetson-user \
    && sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' /tmp/jetson-packages.txt \
       | xargs -r /usr/local/bin/astro-ros-install
COPY dev.helper.txt /home/roboboat/.helper.txt
RUN /usr/local/sbin/jetson-user
USER roboboat
WORKDIR /home/roboboat/roboboat_ws
CMD ["sleep", "infinity"]
