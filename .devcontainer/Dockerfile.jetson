ARG BASE_IMAGE=lunarzdev/astro:deps
FROM ${BASE_IMAGE}

ARG USERNAME=roboboat
ARG USER_UID=1000
ARG USER_GID=1000
ENV ROS_DISTRO=jazzy \
    ROS_WS=/home/roboboat/roboboat_ws \
    PATH=/workspace/venv/bin:${PATH} \
    SHELL=/bin/bash
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY requirements.txt /tmp/astro/requirements.txt
COPY pip.conf /etc/pip.conf
COPY normalize-python-permissions.sh /usr/local/sbin/normalize-python-permissions
COPY image-smoke.sh /usr/local/bin/astro-smoke

# This final layer deliberately contains no apt, rosdep, or compilation. The
# native ARM64 dependency image owns those expensive and platform-sensitive
# operations; this layer only establishes the stable developer interface.
RUN python3 -m venv --system-site-packages /workspace/venv \
    && /workspace/venv/bin/pip install --no-cache-dir -r /tmp/astro/requirements.txt \
    && /usr/local/sbin/normalize-python-permissions \
    && existing_user="$(getent passwd "${USER_UID}" | cut -d: -f1 || true)" \
    && existing_group="$(getent group "${USER_GID}" | cut -d: -f1 || true)" \
    && if [[ -n "${existing_user}" && "${existing_user}" != "${USERNAME}" ]]; then userdel "${existing_user}"; fi \
    && if [[ -n "${existing_group}" && "${existing_group}" != "${USERNAME}" ]]; then groupdel "${existing_group}"; fi \
    && if ! getent group "${USERNAME}" >/dev/null; then groupadd --gid "${USER_GID}" "${USERNAME}"; fi \
    && if ! id "${USERNAME}" >/dev/null 2>&1; then useradd --uid "${USER_UID}" --gid "${USER_GID}" --create-home --shell /bin/bash "${USERNAME}"; fi \
    && usermod -aG dialout,video,sudo "${USERNAME}" \
    && if [[ -d /usr/local/zed ]]; then \
         while read -r zed_gid; do \
           zed_group="$(getent group "${zed_gid}" | cut -d: -f1 || true)"; \
           if [[ -z "${zed_group}" ]]; then zed_group="zed_${zed_gid}"; groupadd --gid "${zed_gid}" "${zed_group}"; fi; \
           usermod -aG "${zed_group}" "${USERNAME}"; \
         done < <(find /usr/local/zed -xdev -printf '%G\n' | sort -un); \
       fi \
    && printf '%s ALL=(ALL) NOPASSWD:ALL\n' "${USERNAME}" > "/etc/sudoers.d/${USERNAME}" \
    && chmod 0440 "/etc/sudoers.d/${USERNAME}" \
    && touch "/home/${USERNAME}/.sudo_as_admin_successful" \
    && mkdir -p "${ROS_WS}" \
    && chown -R "${USERNAME}:${USERNAME}" /workspace "${ROS_WS}" \
    && rm -rf /tmp/astro

USER ${USERNAME}
RUN astro-smoke jetson
WORKDIR ${ROS_WS}
CMD ["sleep", "infinity"]
