ARG BASE_IMAGE=lunarzdev/astro:deps
FROM ${BASE_IMAGE}

ARG USERNAME=roboboat
ARG USER_UID=1000
ARG USER_GID=1000
ENV ROS_DISTRO=jazzy \
    ROS_WS=/home/roboboat/roboboat_ws \
    PATH=/workspace/venv/bin:${PATH} \
    SHELL=/bin/bash
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
LABEL org.astro.jetpack="6" org.astro.ros="jazzy" org.astro.role="camera"

COPY requirements.txt /tmp/astro/requirements.txt
COPY pip.conf /etc/pip.conf
COPY normalize-python-permissions.sh /usr/local/sbin/normalize-python-permissions
COPY configure-zed-access.sh /usr/local/sbin/configure-zed-access
COPY image-smoke.sh /usr/local/bin/astro-smoke
COPY jetson-user.sh /usr/local/sbin/jetson-user
COPY dev.helper.txt /home/roboboat/.helper.txt
COPY --chmod=755 astro-camera-preview.py /usr/local/bin/astro-camera-preview

# This final layer deliberately contains no apt, rosdep, or compilation. The
# native ARM64 dependency image owns those expensive and platform-sensitive
# operations; this layer only establishes the stable developer interface.
RUN python3 -m venv --system-site-packages /workspace/venv \
    && /workspace/venv/bin/pip install --no-cache-dir -r /tmp/astro/requirements.txt \
    && /usr/local/sbin/normalize-python-permissions \
    && chmod +x /usr/local/sbin/jetson-user \
    && /usr/local/sbin/jetson-user "${USERNAME}" "${USER_UID}" "${USER_GID}" \
    && rm -rf /tmp/astro

USER ${USERNAME}
WORKDIR ${ROS_WS}
CMD ["sleep", "infinity"]
