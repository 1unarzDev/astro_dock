# Copy to .env (ignored) or symlink .env to a file outside the repo; chmod 600.
# KEY=value per line, no spaces around '='. Variables already set in the environment win.

# Ubiquiti radio SSH login (ubiquiti_setup.sh snapshot/apply).
UBNT_USER=
UBNT_PASSWORD=
# Optional SSH jump host on the boat LAN, e.g. the gateway laptop, when running off-LAN.
UBNT_JUMP=

# DD-WRT router (router_setup.sh): SSH login (root on DD-WRT) and its password,
# the web-admin password (required), and the boat Wi-Fi WPA2 key (8-63 characters).
ROUTER_USER=
ROUTER_PASSWORD=
ROUTER_ADMIN_PASSWORD=
BOAT_WIFI_PASSWORD=
